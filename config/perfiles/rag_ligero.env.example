# Plantilla de TAG ligero; conserva el generador 27B, no es un RAG ligero completo.
# No copiar sobre .env para ejecutar la sonda: usar --perfil ligero.
# Corpus de referencia: data/corpus. La sonda solo usa tres textos sintéticos.
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
EMBED_BATCH_SIZE=50
EMBED_TIMEOUT=600
GEN_PROVIDER=ollama
OLLAMA_GEN_MODEL=smtek/Qwen3.8-27B:Q2_K_XL-16gb
GEN_TIMEOUT=240
TAG_PROVIDER=ollama
OLLAMA_TAG_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHUNK_SIZE=1000
CHUNK_OVERLAP=120
TAG_SCORING_DEDUP=true
DEDUP_UMBRAL=0.93
DEDUP_AUDIT=true
DEDUP_AUDIT_RUTA=output/dedup_audit.jsonl
EXPORT_EMBEDDINGS=true
TOP_K=5
MAX_CHUNKS=5
RAG_RETRIEVAL_MODE=hibrido
CHROMA_DIR=./output/chromadb
COLLECTION_NAME=deporte_municipal
# Solo la sonda consume BENCH_MODE. El adaptador real fija timeout=120.
BENCH_MODE=adapter
