##################################################################
####### SUPERVISOR Y GRAFO
##################################################################
# Configuración utilizada por supervisor y grafo.
MAX_ITER=8
# Conector RAG: módulo y función que confirmará su responsable.
RAG_CALLABLE=
# Límites pendientes de integrar con sus módulos.
MAX_STEPS=4
MAX_TURNS=
HTTP_TIMEOUT=


##################################################################
####### RAG
##################################################################
#  Proveedores de embeddings y de generación ---
# "ollama" (offline, sin coste) | "huggingface" | "google"
EMBED_PROVIDER="ollama"
TAG_PROVIDER="ollama"
GEN_PROVIDER="ollama"

# utliza GOOGLE_API_KEY Y MODELO GEMINI MULTIMODAL
VISION_MODEL="gemini-3.8-flash"


# Permite "vectorial" | "hibrido" en caso de duda dejar "hibrido"
RAG_RETRIEVAL_MODE="hibrido" 

GOOGLE_API_KEY=""

HF_TOKEN=""

#  Google (online) ------------------------------------
GOOGLE_EMBED_MODEL="gemini-embedding-2"
GOOGLE_TAG_MODEL="gemini-3.6-flash"
GOOGLE_GEN_MODEL="gemini-3.6-flash"
#  Ollama (offline) -----------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBED_MODEL="qwen3-embedding:0.6b"
OLLAMA_TAG_MODEL="smtek/Qwen3.8-27B:Q2_K_XL-16gb"
OLLAMA_GEN_MODEL="smtek/Qwen3.8-27B:Q2_K_XL-16gb"
#  HuggingFace (online) -------------------------------
HF_EMBED_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
HF_TAG_MODEL="meta-llama/Llama-3.2-3B-Instruct"
HF_GEN_MODEL="meta-llama/Llama-3.2-3B-Instruct"
# "cpu" | "cuda" → carga los modelos (embeddings y/o generación) en CPU o GPU de modo que la inferencia se ejecuta en ese recurso. NOTA: "cuda" requiere GPU de NVIDIA con drivers instalados.
HF_DEVICE="cuda"  
# Dejar vacío solo si el modelo es gated 

#  Chunking 
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5
MAX_CHUNKS=5

#  Embeddings
# Tope máximo de dimensión del índice: dim final = min(dim del modelo, EMBED_DIM).
EMBED_DIM=1024
EMBED_BATCH_SIZE=50
EXPORT_EMBEDDINGS=true
EMBED_CHECKPOINT_ENABLED=true
# Dimensión nativa máxima del modelo de embeddings. La comprobación online
# (PREFLIGHT) solo verifica la disponibilidad, nunca la dimensión: por eso se
# declara aquí. Alimenta el caché offline (red cortada / sin API key) y los
# mensajes de dimensiones (INFO si EMBED_DIM < dim modelo; AVISO si EMBED_DIM
# supera la dimensión generada). Vacío = no declarada (la fila EMBED_DIM_MODELO
# del informe lo indica). Ej.: 384 (all-MiniLM-L6-v2) · 2560 (qwen3-embedding:4b)
# Vacío = no declarado.
EMBED_DIM_MAX_OLLAMA=
EMBED_DIM_MAX_HF=
EMBED_DIM_MAX_GOOGLE=

#  TSD (tag + scoring + dedup) 
TAG_SCORING_DEDUP=true
DEDUP_UMBRAL=0.93
# Auditoría de pares descartados: una línea JSON por descarte (coseno/clave,
# similitud, chunk afectado y vencedor). Vacío (false) = sin auditoría.
DEDUP_AUDIT=true
DEDUP_AUDIT_RUTA="output/dedup_audit.jsonl"

#  Eval set (offline, durante el indexado)
# Genera queries/eval_set.jsonl con el interruptor GEN (despues de dedup).
# Cada consulta fallida se omite sin detener el indexado.
EVAL_SET=true
EVAL_SET_N=50
EVAL_SET_RUTA="queries/eval_set.jsonl"
# Timeout por llamada al chat de Ollama (GEN)
GEN_TIMEOUT=240

#  ChromaDB 
CHROMA_DIR="./output/chromadb"
COLLECTION_NAME="deporte_municipal"
# Después del indexado generará un set de dos preguntas por embedding 
# si el valor está a 'true' y en la ruta definida.
QUESTION_SET=true
MAX_QUESTIONS=2
QUESTION_SET_RUTA="./output/question_set.json"

# OCR para PDF
# Binario de Tesseract: nombre en PATH o ruta absoluta (ej. C:\Program Files\Tesseract-OCR\tesseract.exe)
OCR_AGENT="tesseract"
# Idioma de OCR: requiere el traineddata instalado (spa, eng, ...)
OCR_LANG="spa"
# DIAGNOSTICO RAG
RAG_CON_DIAGNOSTICO=False