##################################################################
####### SUPERVISOR Y GRAFO
##################################################################
# Configuración utilizada por supervisor y grafo.
MAX_ITER=8
# Conector RAG: módulo y función que confirmará su responsable.
RAG_CALLABLE=
# Límites pendientes de integrar con sus módulos.
MAX_STEPS=4
MAX_TURNS=
HTTP_TIMEOUT=


##################################################################
####### RAG
##################################################################
# Proveedores de embeddings y de generación.
# "ollama" (offline) | "huggingface" | "google"
EMBED_PROVIDER="google"
TAG_PROVIDER="google"
GEN_PROVIDER="google"

# --- Imágenes / OCR / multimodal ---
IMAGE_OCR_ENABLED=true
IMAGE_VISION_ENABLED=false

# Modelo multimodal para descripción de imágenes.
# Si se deja vacío, hereda el modelo efectivo de GEN.
IMAGE_VISION_MODEL=

IMAGE_OCR_LANG=spa+eng
IMAGE_MAX_DESCRIPTION_CHARS=1200

# Permite "vectorial" | "hibrido". En caso de duda, dejar "hibrido".
RAG_RETRIEVAL_MODE="hibrido"

GOOGLE_API_KEY=""
HF_TOKEN=""

# --- Google (online) ---
GOOGLE_EMBED_MODEL="gemini-embedding-2"
GOOGLE_TAG_MODEL="gemini-3.6-flash"
GOOGLE_GEN_MODEL="gemini-3.6-flash"

# --- Ollama (offline) ---
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBED_MODEL="qwen3-embedding:0.6b"
OLLAMA_TAG_MODEL="smtek/Qwen3.8-27B:Q2_K_XL-16gb"
OLLAMA_GEN_MODEL="smtek/Qwen3.8-27B:Q2_K_XL-16gb"

# --- HuggingFace (online) ---
HF_EMBED_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
HF_TAG_MODEL="meta-llama/Llama-3.2-3B-Instruct"
HF_GEN_MODEL="meta-llama/Llama-3.2-3B-Instruct"

# "cpu" | "cuda"
HF_DEVICE="cuda"

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5
MAX_CHUNKS=5

# --- Embeddings ---
# Tope máximo de dimensión del índice:
# dimensión final = min(dim nativa del modelo, EMBED_DIM).
EMBED_DIM=1024
EMBED_BATCH_SIZE=50
EXPORT_EMBEDDINGS=true
EMBED_CHECKPOINT_ENABLED=true

# Dimensión nativa máxima declarada por modelo.
# Se usa como caché offline si Ollama/HF/Google no puede consultarse.
# qwen3-embedding:0.6b tiene 1024 dimensiones.
EMBED_DIM_MAX_OLLAMA=1024
EMBED_DIM_MAX_HF=
EMBED_DIM_MAX_GOOGLE=

# --- TSD: tagging + scoring + dedup ---
TAG_SCORING_DEDUP=true
DEDUP_UMBRAL=0.93
DEDUP_AUDIT=true
DEDUP_AUDIT_RUTA="output/dedup_audit.jsonl"

# --- Eval set ---
EVAL_SET=true
EVAL_SET_N=50
EVAL_SET_RUTA="queries/eval_set.jsonl"
GEN_TIMEOUT=240

# --- ChromaDB ---
CHROMA_DIR="./output/chromadb"
COLLECTION_NAME="deporte_municipal"

# --- Question set ---
QUESTION_SET=true
MAX_QUESTIONS=2
QUESTION_SET_RUTA="./output/question_set.json"

# --- OCR para PDF ---
# Ruta absoluta al binario de Tesseract.
# Vacío = usar el tesseract disponible en PATH.
TESSERACT_CMD=

# Solo Windows si Poppler no está en PATH.
# Ejemplo: C:\Program Files\poppler-24.08.0\Library\bin
POPPLER_PATH=

OCR_LANG=spa
OCR_DPI=200
OCR_PSM=6

# --- Diagnóstico RAG ---
RAG_CON_DIAGNOSTICO=False